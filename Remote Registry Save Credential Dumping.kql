// Title: Remote Registry Save (Credential Dumping)
// Description: Detects inbound RPC calls to the Windows Remote Registry interface using operation numbers associated with registry save/backup operations, which may indicate credential dumping via remote registry access.
// MITRE ATT&CK: T1003.002
// Tactics: Credential Access
// Platform: Microsoft Defender for Endpoint

DeviceEvents
| where ActionType == "InboundRemoteRpcCall"
| extend f = parse_json(AdditionalFields)
| mv-expand kv = bag_keys(f)
| extend RpcUuid = tostring(f["RpcInterfaceUuid"]), RpcOp = toint(f["RpcOpNum"])
| where RpcUuid in ("338cd001-2244-31f1-aaaa-900038001003")
| where RpcOp in (20, 31)
| project TimeGenerated, DeviceName, AccountName, RpcUuid, RpcOp
