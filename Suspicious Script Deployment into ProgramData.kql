// Title: Suspicious Script Deployment into ProgramData
// Description: Identifies the creation of PowerShell or batch files in unusual ProgramData subdirectories by command-line interpreters, which may indicate malware staging or persistence preparation.
// MITRE ATT&CK: T1059.001, T1059.003, T1105
// Tactics: Execution, Command and Control
// Platform: Microsoft Defender for Endpoint

DeviceFileEvents
| where ActionType =~ "FileCreated"
| where FolderPath startswith @"C:\ProgramData\"
| where FileName matches regex @".*\.(ps1|bat)$"
| where InitiatingProcessFileName =~ "cmd.exe"
| where FolderPath !contains "Microsoft"
| where FolderPath !contains "Package Cache"
