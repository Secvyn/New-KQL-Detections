// Title: Script Staging in ProgramData Directory
// Description: Detects creation of PowerShell or batch scripts under C:\ProgramData, a directory commonly abused by malware for payload staging and persistence.
// MITRE ATT&CK: T1059.001, T1059.003, T1105
// Tactics: Execution, Command and Control
// Platform: Microsoft Defender for Endpoint

DeviceFileEvents
| where FolderPath startswith @"C:\ProgramData\"
| where FileName matches regex @".*\.(ps1|bat)$"
| where InitiatingProcessFileName in~ ("cmd.exe","powershell.exe")
